# Copy this file to wilma_secrets.env, then fill in the values locally.
# wilma_secrets.env is ignored by git and must never be committed.
WILMA_CITY=espoo
WILMA_USER=
WILMA_PASS=

# Optional labels for the diagnostic output. Format: !role-slug:Child name
WILMA_CHILDREN=!12345678:First child,!87654321:Second child